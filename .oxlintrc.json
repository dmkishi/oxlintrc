{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
  ],

  /**
   * Set groups of rules by category. This is a convenient way to set large
   * groups of rules at once.
   *
   * Prefer categorically enabling rules then disabling individual rules below.
   *
   * - "correctness": Code that is outright wrong or useless.
   * - "suspicious": Code that is most likely wrong or useless.
   * - "pedantic": Lints which are rather strict or have occasional false positives.
   * - "style": Code that should be written in a more idiomatic way.
   * - "perf": Code that can be written to run faster.
   * - "nursery": New lints that are still under development
   * - "restriction": Don't use.
   */
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "style": "warn",
  },

  /**
   * Set individual rules: https://oxc.rs/docs/guide/usage/linter/rules.html
   */
  "rules": {
    /* Pedantic */
    "max-depth": ["error", { "max": 5 }],
    "max-classes-per-file": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "no-inline-comments": "off", // Agree but flags syntax hints.
    "typescript/prefer-readonly-parameter-types": [
      "error",
      /**
       * "This rule is very strict on what it considers mutable. Many types that
       * describe themselves as readonly are considered mutable because they
       * have mutable properties such as arrays or tuples. To work around these
       * limitations, you might need to use the rule's options. In particular,
       * the `allow` option can explicitly mark a type as readonly."
       * <https://typescript-eslint.io/rules/prefer-readonly-parameter-types/#when-not-to-use-it>
       *
       * NOTE: `allow` accepts plain string names or object specifiers. Prefer
       * strings: object specifiers like `{ "from": "lib" }` match a type's
       * declaration site, and `from: "lib"` matches only TypeScript's built-in
       * `lib.*.d.ts`. `AbortSignal` and `Response` are web globals. In a Node
       * project without the `DOM` lib they come from `@types/node`, so that
       * `from: "lib"` won't match and the rule keeps firing. Strings match by
       * name, so the allowlist holds regardless of whether a type originates in
       * `lib`, `@types/node`, or a package.
       */
      {
        "allow": [
          "AbortSignal",
          "Response",
        ],
      }
    ],

    /* Style */
    "capitalized-comments": "off", // Agree but cannot detect consecutive lines.
    "curly": ["error", "multi-line", "consistent"],
    "func-style": "off",
    "id-length": "off", // Agree but prefer exception in single-line functions.
    "init-declarations": "off",
    "max-params": ["error", { "max": 4 }],
    "max-statements": "off",
    "no-continue": "off", // Agree but prefer "returning" early.
    "no-magic-numbers": "off", // Agree but too cumbersome.
    "no-ternary": "off",
    "prefer-destructuring": "off",
    "prefer-template": "off",
    "sort-imports": "off", // Disagree on sort order.
    "sort-keys": "off", // Disagree on sort order.
    "unicorn/filename-case": "off", // Flags "node:child_process"
    "unicorn/no-await-expression-member": "off",
    "unicorn/numeric-separators-style": [
      "error",
      { "number": { "minimumDigits": 4 } }
    ],

    /* Perf */
    "no-useless-call": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-flat-map": "error",
  },
  "env": {
    "builtin": true, // Support built-in globals (console, setTimeout, etc.)
  },
}
